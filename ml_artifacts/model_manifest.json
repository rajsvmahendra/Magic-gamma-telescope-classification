{
  "project_source": "INT315 Project 68",
  "engine": "Apache PySpark ML",
  "pyspark_version": "3.5.9",
  "python_version": "3.11.9",
  "training_split": {
    "train_ratio": 0.8,
    "test_ratio": 0.2,
    "seed": 42,
    "train_instances": 15278,
    "test_instances": 3742
  },
  "label_encoding": {
    "column": "class",
    "output_column": "label",
    "mapping": {
      "0.0": "Gamma (signal)",
      "1.0": "Hadron (background)"
    }
  },
  "models": {
    "random_forest": {
      "model_type": "RandomForestClassificationModel",
      "artifact_relative_path": "../models/random_forest",
      "required_features_column": "features",
      "requires_scaling": false,
      "hyperparameters": {
        "numTrees": 100,
        "maxDepth": 5,
        "impurity": "gini",
        "seed": 42
      },
      "evaluation_metrics": {
        "accuracy": 0.8407,
        "precision": 0.8454,
        "recall": 0.8407,
        "f1_score": 0.8338,
        "roc_auc": 0.8869
      },
      "class_metrics": {
        "gamma": {
          "precision": 0.8281,
          "recall": 0.9508
        },
        "hadron": {
          "precision": 0.8769,
          "recall": 0.6400
        }
      },
      "confusion_matrix": {
        "true_gamma_pred_gamma": 2298,
        "true_gamma_pred_hadron": 119,
        "true_hadron_pred_gamma": 477,
        "true_hadron_pred_hadron": 848
      }
    },
    "logistic_regression": {
      "model_type": "LogisticRegressionModel",
      "artifact_relative_path": "../models/logistic_regression_scaled",
      "required_features_column": "scaledFeatures",
      "requires_scaling": true,
      "scaler_specification": {
        "inputCol": "features",
        "outputCol": "scaledFeatures",
        "withMean": true,
        "withStd": true,
        "trained_on": "train_df (seed=42)"
      },
      "hyperparameters": {
        "maxIter": 100,
        "regParam": 0.0,
        "elasticNetParam": 0.0,
        "standardization": true
      },
      "evaluation_metrics": {
        "accuracy": 0.7875,
        "precision": 0.7852,
        "recall": 0.7875,
        "f1_score": 0.7789,
        "roc_auc": 0.8388
      },
      "class_metrics": {
        "gamma": {
          "precision": 0.7943,
          "recall": 0.9057
        },
        "hadron": {
          "precision": 0.7688,
          "recall": 0.5721
        }
      },
      "confusion_matrix": {
        "true_gamma_pred_gamma": 2189,
        "true_gamma_pred_hadron": 228,
        "true_hadron_pred_gamma": 567,
        "true_hadron_pred_hadron": 758
      }
    }
  }
}
